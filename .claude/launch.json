{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "chrome",
        "--web-port",
        "8080",
        "--dart-define-from-file=cloudinary.local.json"
      ],
      "port": 8080
    },
    {
      "name": "portfolio-web-release",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "chrome",
        "--release",
        "--web-port",
        "8081",
        "--dart-define-from-file=cloudinary.local.json"
      ],
      "port": 8081
    },
    {
      "name": "portfolio-windows",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "windows"
      ]
    }
  ]
}